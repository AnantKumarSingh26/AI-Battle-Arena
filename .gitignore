# ==============================================================================
# Dependencies
# ==============================================================================
# Coordinates third-party packages. Never commit these.
node_modules/
jspm_packages/
web_modules/

# ==============================================================================
# Production / Build Artifacts
# ==============================================================================
# React / Frontend build directories
build/
dist/
out/

# TypeScript build info and compiled JS files (if compiling separate from bundler)
*.tsbuildinfo
# Uncomment the line below if your build step outputs plain JS next to your TS files
# *.js

# ==============================================================================
# Logs and Runtime Data
# ==============================================================================
# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# General logs
logs/
*.log
*.pid
*.seed
*.pid.lock

# ==============================================================================
# Environment Variables & Secrets
# ==============================================================================
# Contains database credentials, API keys, and sensitive tokens
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env.bak

# ==============================================================================
# Testing & Coverage
# ==============================================================================
# Test coverage reports generated by Jest or Vitest
coverage/
.nyc_output/

# ==============================================================================
# Tooling & Caches
# ==============================================================================
# Cache directories for modern bundlers, linters, and frameworks
.eslintcache
.stylelintcache
.prettiercache
.parcel-cache
.turbo/
.cache/
.vite/

# ==============================================================================
# System / OS Files
# ==============================================================================
# Operating system junk files
.DS_Store
Thumbs.db

# ==============================================================================
# IDEs & Editors
# ==============================================================================
# Editor-specific configuration folders
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
